{
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"harness",
		"targets/*",
		"targets/*/vite-plugin",
		"targets/*/kit"
	],
	"scripts": {
		"harness:upstream": "node harness/src/cli.ts targets/upstream",
		"harness:vigla": "node harness/src/cli.ts targets/vigla",
		"harness:passing": "node harness/src/cli.ts targets/vigla --passing",
		"typecheck": "tsrs -p harness --noEmit && tsrs -p targets/upstream --noEmit && tsrs -p packages/vigla --noEmit && tsrs -p packages/svelte --noEmit && tsrs -p targets/vigla --noEmit"
	},
	"devDependencies": {
		"@types/node": "^25.3.1",
		"oxfmt": "^0.72.0",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929"
	},
	"trustedDependencies": [
		"pnpm"
	],
	"overrides": {
		"acorn": "8.18.0",
		"devalue": "5.9.4",
		"esm-env": "1.2.2",
		"esrap": "2.3.6",
		"rolldown": "1.2.9"
	}
}
