{
	"name": "@vigla/kit",
	"version": "0.1.2",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/runlith/vigla.git",
		"directory": "packages/kit"
	},
	"type": "module",
	"files": [
		"dist",
		"src",
		"types"
	],
	"scripts": {
		"build": "node ../../release/src/cli.ts emit"
	},
	"bin": {
		"vigla-kit": "./src/sync/bin.ts"
	},
	"exports": {
		".": {
			"types": "./src/types/index.ts",
			"default": "./src/entries/index.ts"
		},
		"./package.json": "./package.json",
		"./internal/client": "./src/entries/internal/client.ts",
		"./internal/payload": "./src/entries/internal/payload.ts",
		"./internal/server": "./src/entries/internal/server.ts",
		"./adapter": {
			"types": "./src/types/adapter.ts",
			"default": "./src/entries/adapter.ts"
		},
		"./env": {
			"types": "./src/types/env.ts",
			"default": "./src/entries/env.ts"
		},
		"./hooks": {
			"types": "./src/types/hooks.ts",
			"default": "./src/entries/hooks.ts"
		},
		"./node": "./src/node/index.ts",
		"./params": {
			"types": "./src/types/params.ts",
			"default": "./src/entries/params.ts"
		},
		"./vite": {
			"types": "./src/types/config.ts",
			"default": "./src/vite/index.ts"
		},
		"./internal/env": "./src/entries/internal/env.ts",
		"./internal/identity": "./src/entries/internal/identity.ts",
		"./internal/restore": "./src/entries/internal/restore.ts",
		"./internal/sequence": "./src/entries/internal/sequence.ts",
		"./internal/shallow": {
			"workerd": "./src/entries/internal/shallow/server.ts",
			"browser": "./src/entries/internal/shallow/client.ts",
			"default": "./src/entries/internal/shallow/server.ts"
		},
		"./internal/node": "./src/node/static.ts",
		"./cli": "./src/sync/cli.ts"
	},
	"imports": {
		"#internal/origin": {
			"workerd": "./src/server/origin.ts",
			"browser": "./src/client/origin.ts",
			"default": "./src/server/origin.ts"
		},
		"#types/*": "./src/types/*.ts",
		"#app/env": {
			"workerd": "./src/entries/app/env/server.ts",
			"browser": "./src/entries/app/env/client.ts",
			"default": "./src/entries/app/env/server.ts"
		},
		"#app/forms": {
			"workerd": "./src/entries/app/forms/server.ts",
			"browser": "./src/entries/app/forms/client.ts",
			"default": "./src/entries/app/forms/server.ts"
		},
		"#app/navigation": {
			"workerd": "./src/entries/app/navigation/server.ts",
			"browser": "./src/entries/app/navigation/client.ts",
			"default": "./src/entries/app/navigation/server.ts"
		},
		"#app/paths": {
			"workerd": "./src/entries/app/paths/server.ts",
			"browser": "./src/entries/app/paths/client.ts",
			"default": "./src/entries/app/paths/server.ts"
		},
		"#app/service-worker": {
			"browser": "./src/entries/app/service-worker/client.ts"
		},
		"#app/state": {
			"workerd": "./src/entries/app/state/server.ts",
			"browser": "./src/entries/app/state/client.ts",
			"default": "./src/entries/app/state/server.ts"
		},
		"#app/server": {
			"workerd": "./src/entries/app/server/server.ts",
			"default": "./src/entries/app/server/server.ts"
		},
		"#app/env/public": {
			"workerd": "./src/entries/app/env/public/server.ts",
			"default": "./src/entries/app/env/public/server.ts"
		},
		"#app/env/private": {
			"workerd": "./src/entries/app/env/private/server.ts",
			"default": "./src/entries/app/env/private/server.ts"
		},
		"#env/dynamic/public": {
			"workerd": "./src/entries/env/dynamic/public/server.ts",
			"browser": "./src/entries/env/dynamic/public/client.ts",
			"default": "./src/entries/env/dynamic/public/server.ts"
		},
		"#env/dynamic/private": {
			"workerd": "./src/entries/env/dynamic/private/server.ts",
			"default": "./src/entries/env/dynamic/private/server.ts"
		}
	},
	"release": {
		"version": "src/entries/index.ts"
	},
	"dependencies": {
		"@jridgewell/remapping": "^2.3.5",
		"@opentelemetry/api": "^1.9.1",
		"@standard-schema/spec": "^1.1.0",
		"@types/estree": "^1.0.9",
		"@vigla/vite-plugin": "workspace:*",
		"cookie": "^2.0.1",
		"devalue": "^5.9.4",
		"esm-env": "^1.2.2",
		"magic-string": "^0.30.21",
		"mrmime": "^2.0.1",
		"parse5": "^8.0.1",
		"vigla": "workspace:*"
	},
	"peerDependencies": {
		"vite": "^8.0.12"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"vite": "8.2.2",
		"vitest": "5.0.1"
	}
}
