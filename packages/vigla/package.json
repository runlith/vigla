{
	"name": "vigla",
	"version": "0.2.5",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/runlith/vigla.git",
		"directory": "packages/vigla"
	},
	"type": "module",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "node ../../release/src/cli.ts emit"
	},
	"exports": {
		".": {
			"browser": "./src/entries/index.ts",
			"default": "./src/entries/index-server.ts"
		},
		"./package.json": "./package.json",
		"./server": "./src/entries/server.ts",
		"./attachments": "./src/entries/attachments.ts",
		"./action": "./src/entries/action.ts",
		"./events": "./src/entries/events.ts",
		"./reactivity": {
			"browser": "./src/entries/reactivity.ts",
			"default": "./src/entries/reactivity-server.ts"
		},
		"./reactivity/window": {
			"browser": "./src/entries/window.ts",
			"default": "./src/entries/window-server.ts"
		},
		"./motion": {
			"browser": "./src/entries/motion.ts",
			"default": "./src/entries/motion-server.ts"
		},
		"./transition": "./src/entries/transition.ts",
		"./animate": "./src/entries/animate.ts",
		"./easing": "./src/entries/easing.ts",
		"./compiler": "./src/entries/compiler.ts",
		"./internal/index-client": "./src/entries/index.ts",
		"./internal/index-server": "./src/entries/index-server.ts",
		"./internal/reactivity-client": "./src/entries/reactivity.ts",
		"./internal/reactivity-server": "./src/entries/reactivity-server.ts",
		"./internal/window-client": "./src/entries/window.ts",
		"./internal/window-server": "./src/entries/window-server.ts",
		"./internal/motion-client": "./src/entries/motion.ts",
		"./internal/motion-server": "./src/entries/motion-server.ts",
		"./internal/client": "./src/entries/internal/client.ts",
		"./internal/server": "./src/entries/internal/server.ts"
	},
	"dependencies": {
		"@jridgewell/remapping": "^2.3.5",
		"@types/estree": "^1.0.9",
		"acorn": "^8.18.0",
		"aria-query": "5.3.1",
		"axobject-query": "^4.1.0",
		"clsx": "^2.1.1",
		"devalue": "^5.9.4",
		"esm-env": "^1.2.1",
		"esrap": "^2.3.6",
		"magic-string": "^0.30.21"
	},
	"devDependencies": {
		"@types/aria-query": "^5.0.4"
	}
}
