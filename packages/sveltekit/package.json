{
	"name": "@vigla/sveltekit",
	"version": "3.1.2",
	"type": "module",
	"types": "./types/index.d.ts",
	"files": [
		"dist",
		"src",
		"types"
	],
	"scripts": {
		"build": "node ../../release/src/cli.ts emit"
	},
	"bin": {
		"svelte-kit": "./src/bin.ts"
	},
	"vigla": {
		"facade": "@vigla/kit"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./src/types/index.ts",
			"default": "./src/index.ts"
		},
		"./internal/env": "./src/internal/env.ts",
		"./internal/server": "./src/internal/server.ts",
		"./internal/client": "./src/internal/client.ts",
		"./internal/payload": "./src/internal/payload.ts",
		"./internal/restore": "./src/internal/restore.ts",
		"./adapter": {
			"types": "./src/types/adapter.ts",
			"default": "./src/adapter.ts"
		},
		"./node": "./src/node.ts",
		"./hooks": {
			"types": "./src/types/hooks.ts",
			"default": "./src/hooks.ts"
		},
		"./env": "./src/env.ts",
		"./params": {
			"types": "./src/types/params.ts",
			"default": "./src/params.ts"
		},
		"./vite": "./src/vite.ts"
	},
	"release": {
		"version": "src/index.ts"
	},
	"dependencies": {
		"@vigla/kit": "workspace:*",
		"@vigla/vite-plugin-svelte": "workspace:*",
		"esm-env": "^1.2.2"
	},
	"peerDependencies": {
		"svelte": "^5.57.1",
		"vite": "^8.0.12"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"vite": "8.2.2",
		"vitest": "5.0.1"
	}
}
